+/// Sort one person's short run by a u64 key: insertion sort when short (the common case),
+/// the standard unstable sort otherwise. Equal keys may come out in any order.
+#[inline]
+fn sort_run<T: Copy>(v: &mut [T], key: impl Fn(&T) -> u64) {
+    if v.len() <= 32 {
+        for i in 1..v.len() {
+            let x = v[i];
+            let kx = key(&x);
+            let mut j = i;
+            while j > 0 && key(&v[j - 1]) > kx {
+                v[j] = v[j - 1];
+                j -= 1;
+            }
+            v[j] = x;
+        }
+    } else {
+        v.sort_unstable_by_key(|x| key(x));
+    }
+}
